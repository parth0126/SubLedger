# Copy to .env and adjust. Never commit the real .env file.

APP_NAME=SubLedger
DEBUG=false

# PostgreSQL connection parts (used by the API, Alembic and docker-compose).
POSTGRES_USER=subledger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=subledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Alternatively, a full SQLAlchemy URL overrides the POSTGRES_* parts above:
# DATABASE_URL=postgresql+psycopg://subledger:change-me@localhost:5432/subledger

# Host ports published by docker-compose.
POSTGRES_HOST_PORT=5432
API_PORT=8000

# Days between invoice issue date and due date.
INVOICE_DUE_DAYS=14

# Optional: run the test suite against PostgreSQL instead of in-memory SQLite.
# TEST_DATABASE_URL=postgresql+psycopg://subledger:change-me@localhost:5432/subledger_test
